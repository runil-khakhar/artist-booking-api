PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=artist_booking

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=artist_booking

# Required in production, at least 32 characters. Leave empty locally and a random secret is used (tokens reset on restart).
# To generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL_SECONDS=3600

# Password for every demo account created by `npm run db:seed`.
# Use at least 8 characters, or leave it empty and the seed script generates one and prints it.
SEED_USER_PASSWORD=
